#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define TOTAL_BLOCKS 100
#define MAX_FILES 10
#define MAX_FILE_SIZE 20

struct File {
    char name[20];
    int index_block;
    int length;
};

int main() {
    int disk[TOTAL_BLOCKS];
    int index_table[TOTAL_BLOCKS][MAX_FILE_SIZE]; // Stores data blocks for index blocks
    struct File files[MAX_FILES];
    int file_count = 0;
    int choice;

    // Initialize all disk blocks as free (0 means free, 1 means occupied)
    for (int i = 0; i < TOTAL_BLOCKS; i++) {
        disk[i] = 0;
    }

    while (1) {
        printf("\n--- Indexed File Allocation Simulation ---\n");
        printf("1. Create File (Allocate)\n");
        printf("2. Display File Index Information\n");
        printf("3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            if (file_count >= MAX_FILES) {
                printf("Error: Maximum file allocation limit reached!\n");
                continue;
            }

            char name[20];
            int idx_block, len;

            printf("Enter file name: ");
            scanf("%s", name);
            printf("Enter index block number: ");
            scanf("%d", &idx_block);

            // Check if index block is within disk limits and is free
            if (idx_block < 0 || idx_block >= TOTAL_BLOCKS) {
                printf("Error: Index block out of disk bounds.\n");
                continue;
            }
            if (disk[idx_block] == 1) {
                printf("Error: Block %d is already occupied!\n", idx_block);
                continue;
            }

            printf("Enter number of data blocks required (Max %d): ", MAX_FILE_SIZE);
            scanf("%d", &len);

            if (len <= 0 || len > MAX_FILE_SIZE) {
                printf("Error: Invalid file size.\n");
                continue;
            }

            // Count available blocks to ensure file can fit (excluding the index block itself)
            int free_blocks_count = 0;
            for (int i = 0; i < TOTAL_BLOCKS; i++) {
                if (disk[i] == 0 && i != idx_block) {
                    free_blocks_count++;
                }
            }

            if (free_blocks_count < len) {
                printf("Error: Not enough space on disk to allocate %d data blocks.\n", len);
                continue;
            }

            // Allocate the index block
            disk[idx_block] = 1;
            
            // Randomly / Sequentially look for free data blocks on disk
            int blocks_allocated = 0;
            for (int i = 0; i < TOTAL_BLOCKS && blocks_allocated < len; i++) {
                // Avoid using our own index block as data
                if (disk[i] == 0 && i != idx_block) {
                    disk[i] = 1;
                    index_table[idx_block][blocks_allocated] = i; // Save pointer map
                    blocks_allocated++;
                }
            }

            // Record metadata
            strcpy(files[file_count].name, name);
            files[file_count].index_block = idx_block;
            files[file_count].length = len;
            file_count++;

            printf("Success: File '%s' allocated successfully.\n", name);
            printf("Index Block: %d maps to Data Blocks -> ", idx_block);
            for (int i = 0; i < len; i++) {
                printf("%d ", index_table[idx_block][i]);
            }
            printf("\n");

        } else if (choice == 2) {
            if (file_count == 0) {
                printf("No files allocated yet.\n");
                continue;
            }

            char search_name[20];
            int found = -1;

            printf("Enter file name to display index table: ");
            scanf("%s", search_name);

            for (int i = 0; i < file_count; i++) {
                if (strcmp(files[i].name, search_name) == 0) {
                    found = i;
                    break;
                }
            }

            if (found == -1) {
                printf("Error: File not found.\n");
            } else {
                int ib = files[found].index_block;
                printf("\n--- File Mapping details for '%s' ---\n", files[found].name);
                printf("Index Block Address: %d\n", ib);
                printf("Entry Pointer Table:\n");
                for (int i = 0; i < files[found].length; i++) {
                    printf("  Index[%d] ----> Points to Data Block: %d\n", i, index_table[ib][i]);
                }
            }

        } else if (choice == 3) {
            printf("Exiting simulation.\n");
            break;
        } else {
            printf("Invalid entry. Please choose options 1, 2, or 3.\n");
        }
    }

    return 0;
}
