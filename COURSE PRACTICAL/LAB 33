#include <stdio.h>

int findOptimal(int pages[], int frames[], int no_of_pages, int no_of_frames, int index) {
    int res = -1, farthest = index;
    for (int i = 0; i < no_of_frames; i++) {
        int j;
        for (j = index; j < no_of_pages; j++) {
            if (frames[i] == pages[j]) {
                if (j > farthest) {
                    farthest = j;
                    res = i;
                }
                break;
            }
        }
        // If a page is never referenced in the future, return it immediately
        if (j == no_of_pages)
            return i;
    }
    // If all pages will be used in the future, return the farthest one, 
    // otherwise return the first frame by default
    return (res == -1) ? 0 : res;
}

int main() {
    int no_of_frames = 3;
    int no_of_pages = 8;
    int pages[] = {7, 0, 1, 2, 0, 3, 0, 4};
    int frames[3];
    int pageFaults = 0;

    for (int i = 0; i < no_of_frames; i++) {
        frames[i] = -1;
    }

    printf("Incoming \t Frame 1 \t Frame 2 \t Frame 3\n");

    for (int i = 0; i < no_of_pages; i++) {
        int flag1 = 0, flag2 = 0;

        // Check for Page Hit
        for (int j = 0; j < no_of_frames; j++) {
            if (frames[j] == pages[i]) {
                flag1 = flag2 = 1;
                break;
            }
        }

        // Handle Page Fault with empty frames available
        if (flag1 == 0) {
            for (int j = 0; j < no_of_frames; j++) {
                if (frames[j] == -1) {
                    pageFaults++;
                    frames[j] = pages[i];
                    flag2 = 1;
                    break;
                }
            }
        }

        // Handle Page Fault requiring Optimal replacement logic
        if (flag2 == 0) {
            int pos = findOptimal(pages, frames, no_of_pages, no_of_frames, i + 1);
            pageFaults++;
            frames[pos] = pages[i];
        }

        // Print frame visualization
        printf("%d \t\t", pages[i]);
        for (int j = 0; j < no_of_frames; j++) {
            if (frames[j] != -1)
                printf(" %d \t\t", frames[j]);
            else
                printf(" - \t\t");
        }
        printf("\n");
    }

    printf("\nTotal Page Faults: %d\n", pageFaults);
    return 0;
}
