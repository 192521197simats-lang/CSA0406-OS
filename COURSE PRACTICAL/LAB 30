#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <unistd.h>

// Global thread IDs to compare in pthread_equal
pthread_t t1, t2;

void* thread_function(void* arg) {
    int thread_num = *((int*)arg);
    pthread_t current_thread = pthread_self();

    printf("\n[Thread %d] Started running...\n", thread_num);

    // Demonstrate (iii) pthread_equal
    if (pthread_equal(current_thread, t1)) {
        printf("[Thread %d] Identified as Thread 1 using pthread_equal().\n", thread_num);
    } else if (pthread_equal(current_thread, t2)) {
        printf("[Thread %d] Identified as Thread 2 using pthread_equal().\n", thread_num);
    }

    sleep(1);

    printf("[Thread %d] Exiting using pthread_exit()...\n", thread_num);

    // Demonstrate (iv) pthread_exit
    pthread_exit(NULL);
}

int main() {
    int id1 = 1, id2 = 2;

    printf("=== POSIX Thread Concepts Demonstration ===\n");

    // Demonstrate (i) pthread_create
    printf("Creating Thread 1...\n");
    if (pthread_create(&t1, NULL, thread_function, &id1) != 0) {
        printf("Failed to create Thread 1.\n");
        return 1;
    }

    printf("Creating Thread 2...\n");
    if (pthread_create(&t2, NULL, thread_function, &id2) != 0) {
        printf("Failed to create Thread 2.\n");
        return 1;
    }

    // Compare t1 and t2 directly in main
    if (pthread_equal(t1, t2)) {
        printf("Main: Thread 1 and Thread 2 are EQUAL.\n");
    } else {
        printf("Main: Thread 1 and Thread 2 are NOT EQUAL.\n");
    }

    // Demonstrate (ii) pthread_join
    printf("\nMain: Waiting for threads to finish via pthread_join()...\n");
    pthread_join(t1, NULL);
    printf("Main: Thread 1 joined successfully.\n");

    pthread_join(t2, NULL);
    printf("Main: Thread 2 joined successfully.\n");

    printf("\nAll threads finished execution. Main program terminating.\n");
    return 0;
}
