#include <stdio.h>

int findLRU(int time[], int n) {
    int i, minimum = time[0], pos = 0;
    for (i = 1; i < n; ++i) {
        if (time[i] < minimum) {
            minimum = time[i];
            pos = i;
        }
    }
    return pos;
}

int main() {
    int no_of_frames = 3;
    int no_of_pages = 5;
    int frames[3];
    int pages[5] = {4, 1, 2, 4, 5};
    int time[3];
    
    int i, j, pos, flag1, flag2, pageFaults = 0, counter = 0;

    // Initialize all frames as empty (-1)
    for (i = 0; i < no_of_frames; ++i) {
        frames[i] = -1;
    }

    printf("Incoming \t Frame 1 \t Frame 2 \t Frame 3\n");

    for (i = 0; i < no_of_pages; ++i) {
        flag1 = flag2 = 0;

        // Check if page already exists in one of the frames (Page Hit)
        for (j = 0; j < no_of_frames; ++j) {
            if (frames[j] == pages[i]) {
                counter++;
                time[j] = counter; // Update recent usage time
                flag1 = flag2 = 1;
                break;
            }
        }

        // If page is not in frames and there is an empty frame slot
        if (flag1 == 0) {
            for (j = 0; j < no_of_frames; ++j) {
                if (frames[j] == -1) {
                    counter++;
                    pageFaults++;
                    frames[j] = pages[i];
                    time[j] = counter; // Set initial usage time
                    flag2 = 1;
                    break;
                }
            }
        }

        // If page is not in frames and all frames are full (Page Replacement)
        if (flag2 == 0) {
            pos = findLRU(time, no_of_frames); // Find the least recently used slot
            counter++;
            pageFaults++;
            frames[pos] = pages[i];
            time[pos] = counter; // Update time for the new page
        }

        // Print current state of frames
        printf("%d \t\t", pages[i]);
        for (j = 0; j < no_of_frames; ++j) {
            if (frames[j] != -1)
                printf(" %d \t\t", frames[j]);
            else
                printf(" - \t\t");
        }
        printf("\n");
    }

    printf("\nTotal Page Faults: %d\n", pageFaults);
    return 0;
}
