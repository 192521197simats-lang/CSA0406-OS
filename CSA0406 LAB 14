#include <stdio.h>
#include <string.h>

int main()
{
    char file[20][30];
    int n;

    printf("Enter number of files: ");
    scanf("%d",&n);

    for(int i=0;i<n;i++)
    {
        printf("Enter file %d: ",i+1);
        scanf("%s",file[i]);
    }

    printf("\nFiles in Directory\n");

    for(int i=0;i<n;i++)
        printf("%s\n",file[i]);

    return 0;
}
