#include <stdio.h>

int main() {
    int pages, tlb_size;
    int page_table[100];
    int tlb_page[100], tlb_frame[100];
    int page, frame;
    int tlb_hit = 0;
    int i;

    float hit_ratio;
    float tlb_time, memory_time;
    float hit_time, miss_time, eat;

    printf("Enter number of pages: ");
    scanf("%d", &pages);

    printf("\nEnter page table:\n");

    for (i = 0; i < pages; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &page_table[i]);
    }

    printf("\nEnter TLB size: ");
    scanf("%d", &tlb_size);

    printf("\nEnter TLB entries:\n");

    for (i = 0; i < tlb_size; i++) {
        printf("TLB Entry %d - Page: ", i);
        scanf("%d", &tlb_page[i]);

        printf("Frame: ");
        scanf("%d", &tlb_frame[i]);
    }

    printf("\nEnter page number to access: ");
    scanf("%d", &page);

    /* Search TLB */
    for (i = 0; i < tlb_size; i++) {
        if (tlb_page[i] == page) {
            tlb_hit = 1;
            frame = tlb_frame[i];
            break;
        }
    }

    if (tlb_hit) {
        printf("\nTLB HIT!\n");
        printf("Page %d is mapped to Frame %d using TLB.\n",
               page, frame);
    }
    else {
        printf("\nTLB MISS!\n");

        if (page >= 0 && page < pages) {
            frame = page_table[page];

            printf("Page table accessed.\n");
            printf("Page %d is mapped to Frame %d.\n",
                   page, frame);
        }
        else {
            printf("Invalid page number.\n");
            return 0;
        }
    }

    /* Calculate Effective Access Time */

    printf("\nEnter TLB access time (in ns): ");
    scanf("%f", &tlb_time);

    printf("Enter memory access time (in ns): ");
    scanf("%f", &memory_time);

    printf("Enter TLB hit ratio (0 to 1): ");
    scanf("%f", &hit_ratio);

    hit_time = tlb_time + memory_time;
    miss_time = tlb_time + (2 * memory_time);

    eat = hit_ratio * hit_time +
          (1 - hit_ratio) * miss_time;

    printf("\n----- TLB Performance -----\n");
    printf("TLB Hit Time : %.2f ns\n", hit_time);
    printf("TLB Miss Time: %.2f ns\n", miss_time);
    printf("Effective Access Time: %.2f ns\n", eat);

    return 0;
}

