#include <stdio.h>

int main() {
    int base, limit;
    int logical;
    int physical;

    printf("Enter base register: ");
    scanf("%d", &base);

    printf("Enter limit register: ");
    scanf("%d", &limit);

    printf("\nEnter logical address to access: ");
    scanf("%d", &logical);

    printf("\n----- Memory Protection Check -----\n");

    if (logical < 0) {
        printf("ACCESS DENIED!\n");
        printf("Logical address cannot be negative.\n");
    }
    else if (logical >= limit) {
        printf("ACCESS DENIED!\n");
        printf("Address is outside the process address space.\n");
    }
    else {
        physical = base + logical;

        printf("ACCESS GRANTED!\n");
        printf("Logical Address : %d\n", logical);
        printf("Physical Address: %d\n", physical);
    }

    return 0;
}


