#include <stdio.h>

int main() {
    int page_table[100];
    int n, page, offset, page_size;
    int frame, physical;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page size: ");
    scanf("%d", &page_size);

    printf("\nEnter page table:\n");

    for (int i = 0; i < n; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &page_table[i]);
    }

    printf("\nPage Table:\n");
    printf("-------------------\n");
    printf("Page\tFrame\n");
    printf("-------------------\n");

    for (int i = 0; i < n; i++) {
        printf("%d\t%d\n", i, page_table[i]);
    }

    printf("\nEnter logical page number: ");
    scanf("%d", &page);

    printf("Enter offset: ");
    scanf("%d", &offset);

    if (page < 0 || page >= n) {
        printf("\nInvalid page number.\n");
        return 0;
    }

    if (offset < 0 || offset >= page_size) {
        printf("\nInvalid offset.\n");
        return 0;
    }

    frame = page_table[page];
    physical = frame * page_size + offset;

    printf("\nPage Number     : %d\n", page);
    printf("Offset          : %d\n", offset);
    printf("Mapped Frame    : %d\n", frame);
    printf("Physical Address: %d\n", physical);

    return 0;
}

