#include <stdio.h>

int main() {
    int pages, frames, page_size;
    int page_table[100];
    int page, offset;
    int frame, physical;

    printf("Enter number of pages: ");
    scanf("%d", &pages);

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    printf("Enter page size: ");
    scanf("%d", &page_size);

    printf("\nEnter page table entries:\n");

    for (int i = 0; i < pages; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &page_table[i]);
    }

    printf("\nEnter page number: ");
    scanf("%d", &page);

    printf("Enter offset: ");
    scanf("%d", &offset);

    if (page < 0 || page >= pages) {
        printf("\nInvalid page number.\n");
    }
    else if (offset < 0 || offset >= page_size) {
        printf("\nInvalid offset.\n");
    }
    else {
        frame = page_table[page];

        if (frame < 0 || frame >= frames) {
            printf("\nPage is not currently mapped to a valid frame.\n");
        }
        else {
            physical = frame * page_size + offset;

            printf("\nPage Number     : %d\n", page);
            printf("Offset          : %d\n", offset);
            printf("Frame Number    : %d\n", frame);
            printf("Physical Address: %d\n", physical);
        }
    }

    return 0;
}

